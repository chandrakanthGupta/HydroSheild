# ===================================================================
# HydroSheild - AI-Powered Flood Intelligence Platform
# ===================================================================

# 1. Google Gemini AI API Key (Optional: for Disaster Advisory & Action Plan Synthesis)
# Free key available at: https://aistudio.google.com/app/apikey
# If left blank, the platform uses verified rule-based emergency templates.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. MongoDB Atlas Connection URI (Optional: for persistent telemetry & disaster logs)
# If left blank, the platform automatically runs in resilient in-memory storage mode.
MONGODB_URI=

# 3. Twilio SMS & WhatsApp Dispatch Credentials (Optional: for emergency alerts)
# Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MY_PHONE_NUMBER=

# Twilio WhatsApp Sandbox (default sandbox number: whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
MY_WHATSAPP_NUMBER=whatsapp:+910000000000

# 4. Map & Environmental Configuration
# Map uses OpenStreetMap (no API key required): https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
